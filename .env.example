# ─────────────────────────────────────────────────────────────────────────
# ACTIVE FOR LAUNCH
# ─────────────────────────────────────────────────────────────────────────

# Feature flag: keep the investor/ops portal (demo data, mock auth) hidden
# behind "Coming Soon" until the real backend (Phases 1-5) is live.
# See client/src/lib/featureFlags.ts.
VITE_PORTAL_ENABLED=false

# Local dev / Express server (server/index.ts). Netlify production instead
# uses the serverless functions in netlify/functions/*, which currently hold
# their own in-memory sample data — see the "Known gap" note in
# PLATFORM_ARCHITECTURE.md about keeping these two in sync.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# CONTENT — Sanity CMS (schema ready in /studio, not yet wired into client/)
# Prepared for Phase 6. See studio/README.md for what Sanity does and does
# not manage.
# ─────────────────────────────────────────────────────────────────────────
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# ─────────────────────────────────────────────────────────────────────────
# FUTURE / BACKBURNER — Investor Portal Backend (Phases 1-5)
# Not required for the public-site launch. Documented here so the full
# stack is visible in one place. See investor-platform-project-document.html
# Section 03 for the role of each service.
# ─────────────────────────────────────────────────────────────────────────

# Authentication & Identity
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Banking & Payments
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox

# Documents & Legal
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Property Management Data
DOORLOOP_API_KEY=

# Cloud Infrastructure
AWS_RDS_DATABASE_URL=

# Communication
POSTMARK_SERVER_TOKEN=
# — or —
SENDGRID_API_KEY=

# Accreditation Verification (activate only when transitioning to 506(c) / REIT)
PARALLEL_MARKETS_API_KEY=
